# GEMINI_API_KEY: Required for Gemini AI API calls.
# For local/AI Studio runtime, set via Secrets or .env.
# For Netlify deployment, add GEMINI_API_KEY in Site configuration > Environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL where this app is hosted (e.g. your Netlify site URL).
APP_URL="MY_APP_URL"
