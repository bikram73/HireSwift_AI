# Tier 1: Primary AI Provider (Gemini)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Tier 2: First Model Fallback (OpenRouter - used if Gemini fails or key is absent)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Tier 3: Final AI Model Fallback (Groq - used if OpenRouter fails or key is absent)
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.1-8b-instant"

# APP_URL: Optional public URL where this app is hosted (e.g. your Netlify site URL).
APP_URL="MY_APP_URL"
